{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@vue-kernel/*": ["./vue-kernel/*"],
      "@render-adapter/*": ["./render-adapter/*"],
      "@template-transform/*": ["./template-transform/*"],
      "@style-mapper/*": ["./style-mapper/*"],
      "@layout-yoga/*": ["./layout-yoga/*"],
      "@render-skia/*": ["./render-skia/*"],
      "@tauri-window/*": ["./tauri-window/*"],
      "@build-config/*": ["./build-config/*"],
      "@utils/*": ["./utils/*"],
      "@examples/*": ["./examples/*"]
    },
    "typeRoots": ["./types", "./node_modules/@types"],
    "types": ["node"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.vue",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".arts",
    ".codeartsdoer"
  ]
}
